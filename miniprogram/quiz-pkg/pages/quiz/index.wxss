/* quiz-pkg/pages/quiz/index.wxss */
.page { padding: 30rpx 30rpx 80rpx; }

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.dim-name {
  font-size: 30rpx;
  color: var(--theme);
  letter-spacing: 4rpx;
  text-shadow: 0 0 10rpx rgba(var(--theme-rgb), 0.5);
}

.progress-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  font-family: "JetBrains Mono", Menlo, monospace;
}

.bar {
  height: 6rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 4rpx;
  margin-top: 16rpx;
  overflow: hidden;
  position: relative;
}

.bar-fill {
  height: 100%;
  background: var(--theme);
  transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 0 10rpx rgba(var(--theme-rgb), 0.6);
}

.quiz-body {
  transition: transform 0.25s ease-out, opacity 0.25s ease-out;
}
.quiz-body.slide-out {
  transform: translateX(-60rpx);
  opacity: 0;
}
.quiz-body.slide-in {
  animation: slide-in-anim 0.25s ease-out;
}
@keyframes slide-in-anim {
  from { transform: translateX(60rpx); opacity: 0; }
  to   { transform: translateX(0); opacity: 1; }
}

.question {
  margin-top: 60rpx;
  font-size: 36rpx;
  color: #ffffff;
  line-height: 1.55;
  font-weight: 600;
  letter-spacing: 1rpx;
  min-height: 120rpx;
}

.options {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 14rpx;
  background: rgba(255,255,255,0.03);
  transition: all 0.18s ease-out;
}
.option:active { transform: scale(0.98); }
.option.selected {
  border-color: var(--theme);
  background: rgba(var(--theme-rgb), 0.18);
  box-shadow: 0 0 16rpx rgba(var(--theme-rgb), 0.35);
}
.option.selected .opt-letter {
  background: var(--theme);
  color: #fff;
  border-color: var(--theme);
}

.opt-letter {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.3);
  color: rgba(255,255,255,0.6);
  text-align: center;
  line-height: 46rpx;
  margin-right: 20rpx;
  font-size: 24rpx;
  font-family: "JetBrains Mono", Menlo, monospace;
  transition: all 0.2s;
}

.opt-text {
  flex: 1;
  color: #e0e0f0;
  font-size: 28rpx;
  line-height: 1.55;
}

.back-link {
  margin-top: 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.3);
  font-size: 24rpx;
}

.checkpoint-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(10, 10, 26, 0.88);
  backdrop-filter: blur(10rpx);
}

.checkpoint-card {
  width: 100%;
  padding: 42rpx 34rpx;
  text-align: center;
}

.checkpoint-kicker {
  font-size: 22rpx;
  color: var(--theme);
  letter-spacing: 5rpx;
  opacity: 0.8;
}

.checkpoint-label {
  margin-top: 18rpx;
  font-size: 56rpx;
  line-height: 1.2;
  color: #ffffff;
  font-weight: 800;
  text-shadow: 0 0 18rpx rgba(var(--theme-rgb), 0.55);
}

.checkpoint-desc {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #f0f0ff;
}

.checkpoint-note {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.05);
  color: rgba(255,255,255,0.58);
  font-size: 24rpx;
  line-height: 1.6;
}

.checkpoint-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.checkpoint-actions .cyber-btn {
  flex: 1;
  padding-left: 0;
  padding-right: 0;
}
