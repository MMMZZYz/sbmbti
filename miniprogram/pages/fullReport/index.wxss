/* pages/fullReport/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 30rpx 80rpx;
}

.report-head {
  text-align: center;
  padding: 18rpx 0 34rpx;
}

.head-kicker {
  font-size: 22rpx;
  color: var(--theme);
  letter-spacing: 4rpx;
  opacity: 0.86;
}

.head-title {
  margin-top: 18rpx;
  font-family: "JetBrains Mono", "Menlo", monospace;
  font-size: 76rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 6rpx;
  line-height: 1.08;
  text-shadow: 0 0 26rpx rgba(var(--theme-rgb), 0.62);
}

.head-sub {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 5rpx;
}

.head-code {
  display: inline-block;
  margin-top: 18rpx;
  max-width: 100%;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.summary,
.long-card {
  margin-top: 20rpx;
}

.section-title {
  font-size: 19rpx;
  color: var(--theme);
  letter-spacing: 6rpx;
  opacity: 0.8;
  margin-bottom: 18rpx;
}

.block-title {
  margin: 38rpx 0 18rpx;
  text-align: center;
}

.summary-text,
.persona-text,
.long-text,
.dim-desc {
  font-size: 27rpx;
  line-height: 1.85;
  color: #e3e3f2;
  letter-spacing: 0.5rpx;
  white-space: pre-line;
}

.persona-text {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.66);
}

.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dim-card {
  padding: 24rpx;
}

.dim-missing {
  opacity: 0.72;
}

.dim-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.dim-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 2rpx;
}

.dim-emoji {
  font-size: 30rpx;
}

.dim-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #071018;
  background: var(--theme);
}

.dim-status-quick {
  color: var(--theme);
  background: rgba(var(--theme-rgb), 0.12);
  border: 1rpx solid rgba(var(--theme-rgb), 0.46);
}

.dim-type {
  margin-top: 18rpx;
  font-family: "JetBrains Mono", "Menlo", monospace;
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.dim-label {
  margin-top: 4rpx;
  font-size: 25rpx;
  color: var(--theme);
  letter-spacing: 2rpx;
}

.dim-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.66);
}

.bars {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bar-row {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr) 58rpx;
  align-items: center;
  gap: 12rpx;
}

.bar-name,
.bar-pct {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.48);
}

.bar-pct {
  text-align: right;
  font-family: "JetBrains Mono", "Menlo", monospace;
}

.bar-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
}

.bar-winner {
  background: var(--theme);
  box-shadow: 0 0 12rpx rgba(var(--theme-rgb), 0.55);
}

.actions {
  margin-top: 36rpx;
  text-align: center;
}

.disclaimer {
  margin: 34rpx auto 0;
  max-width: 620rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.28);
  letter-spacing: 0;
}
