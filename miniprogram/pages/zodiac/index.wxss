/* pages/zodiac/index.wxss */
.page { padding: 30rpx 30rpx 60rpx; }

.header { padding: 40rpx 0 40rpx; text-align: center; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 18rpx;
}

.z-card {
  padding: 28rpx 10rpx;
  border-radius: 14rpx;
  text-align: center;
  border: 1rpx solid rgba(255,255,255,0.15);
  background: rgba(255, 255, 255, 0.03);
  animation: z-in 0.5s ease-out backwards;
  --c: #ffffff;
  --c-rgb: 255,255,255;
}
.z-card:active { transform: scale(0.95); }
@keyframes z-in {
  from { opacity: 0; transform: scale(0.9); }
  to   { opacity: 1; transform: scale(1); }
}

.z-name {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
}

.z-element {
  font-size: 22rpx;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
  color: var(--c);
}

.z-fire   { --c: #ff7b7b; --c-rgb: 255,123,123; border-color: rgba(255,123,123,0.5); }
.z-earth  { --c: #f0c66d; --c-rgb: 240,198,109; border-color: rgba(240,198,109,0.5); }
.z-air    { --c: #5fd9d9; --c-rgb: 95,217,217; border-color: rgba(95,217,217,0.5); }
.z-water  { --c: #9b8bff; --c-rgb: 155,139,255; border-color: rgba(155,139,255,0.5); }
.z-fire,
.z-earth,
.z-air,
.z-water { box-shadow: 0 0 10rpx rgba(var(--c-rgb), 0.2); }

.legend {
  margin-top: 50rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}

.legend-item {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid currentColor;
  opacity: 0.85;
}
.legend-item.z-fire   { color: #ff7b7b; }
.legend-item.z-earth  { color: #f0c66d; }
.legend-item.z-air    { color: #5fd9d9; }
.legend-item.z-water  { color: #9b8bff; }

