/* pages/zodiac/index.wxss */
.page { padding: 30rpx 30rpx 60rpx; }

.header { padding: 30rpx 0 24rpx; text-align: center; }

/* 滚轮框 */
.picker-frame {
  position: relative;
  margin-top: 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(var(--theme-rgb), 0.25);
  background: rgba(255, 255, 255, 0.02);
  overflow: hidden;
}
.zp {
  width: 100%;
  height: 360rpx;
}
.zp-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 36rpx;
  color: #ffffff;
  letter-spacing: 3rpx;
}
/* 中间选中行：主题色高亮 band */
.zp-ind {
  height: 90rpx;
  background: rgba(var(--theme-rgb), 0.10);
  border-top: 1rpx solid rgba(var(--theme-rgb), 0.6);
  border-bottom: 1rpx solid rgba(var(--theme-rgb), 0.6);
}
/* 上下渐隐，让非选中项融进背景 */
.zp-fade {
  position: absolute;
  left: 0;
  right: 0;
  height: 135rpx;
  pointer-events: none;
  z-index: 2;
}
.zp-fade-top {
  top: 0;
  background: linear-gradient(to bottom, #0a0a1a 8%, rgba(10, 10, 26, 0));
}
.zp-fade-bottom {
  bottom: 0;
  background: linear-gradient(to top, #0a0a1a 8%, rgba(10, 10, 26, 0));
}

/* 预览卡 */
.preview {
  margin-top: 32rpx;
  padding: 36rpx 30rpx;
  text-align: center;
}
.pv-emoji {
  font-size: 72rpx;
  line-height: 1;
  text-shadow: 0 0 24rpx rgba(var(--theme-rgb), 0.6);
}
.pv-main {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 14rpx;
}
.pv-element {
  font-size: 26rpx;
  color: var(--theme);
  letter-spacing: 2rpx;
}
.pv-sign {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 3rpx;
  text-shadow: 0 0 16rpx rgba(var(--theme-rgb), 0.5);
}
.pv-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}

.confirm-btn {
  display: block;
  margin-top: 40rpx;
  text-align: center;
}
