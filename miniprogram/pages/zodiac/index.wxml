<!--pages/zodiac/index.wxml-->
<view class="page cyber-bg {{themeClass}}">
  <view class="header">
    <view class="cyber-title">星座</view>
    <view class="cyber-subtitle">选择你的公历（阳历）生日</view>
  </view>

  <!-- 生日滚轮（包进主题框 + 渐隐遮罩） -->
  <view class="picker-frame">
    <picker-view
      class="zp"
      indicator-class="zp-ind"
      value="{{pickerValue}}"
      bindchange="onPickerChange"
    >
      <picker-view-column>
        <view wx:for="{{months}}" wx:key="*this" class="zp-item">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{days}}" wx:key="*this" class="zp-item">{{item}}</view>
      </picker-view-column>
    </picker-view>
    <view class="zp-fade zp-fade-top"></view>
    <view class="zp-fade zp-fade-bottom"></view>
  </view>

  <!-- 实时预览 -->
  <view class="preview card card-active">
    <view class="pv-emoji">{{emoji}}</view>
    <view class="pv-main">
      <text class="pv-element">{{element}}</text>
      <text class="pv-sign">{{sign}}</text>
    </view>
    <view class="pv-desc">“{{desc}}”</view>
  </view>

  <view class="cyber-btn cyber-btn-purple confirm-btn" bindtap="onConfirm">确认</view>
</view>
