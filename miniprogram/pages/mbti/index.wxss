/* pages/mbti/index.wxss */
.page { padding: 30rpx 30rpx 80rpx; }
.header { padding: 40rpx 0 40rpx; text-align: center; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

/* 每个 MBTI 卡片用各自分组的颜色（先用 var，再用 group-* override） */
.type-card {
  padding: 22rpx 18rpx;
  border-radius: 14rpx;
  animation: card-in 0.4s ease-out backwards;
  /* default 颜色变量；下面 group-* 会覆盖 */
  --c: #9b6bff;
  --c-rgb: 155,107,255;
  background: rgba(var(--c-rgb), 0.06);
  border: 1rpx solid rgba(var(--c-rgb), 0.3);
}
.type-card.group-nt { --c: #9b6bff; --c-rgb: 155,107,255; }
.type-card.group-nf { --c: #5fd9a8; --c-rgb: 95,217,168; }
.type-card.group-sj { --c: #5fa8ff; --c-rgb: 95,168,255; }
.type-card.group-sp { --c: #ff9b5f; --c-rgb: 255,155,95; }

.type-card:active {
  transform: scale(0.97);
}
.type-card.selected {
  border-color: var(--c);
  background: rgba(var(--c-rgb), 0.18);
  box-shadow: 0 0 18rpx rgba(var(--c-rgb), 0.3);
}

@keyframes card-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.type-code {
  font-family: "JetBrains Mono", "Menlo", monospace;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c);
  letter-spacing: 3rpx;
  text-shadow: 0 0 10rpx rgba(var(--c-rgb), 0.45);
}

.type-label {
  font-size: 28rpx;
  color: #ffffff;
  margin-top: 8rpx;
  font-weight: 500;
}

.type-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* legend */
.legend {
  margin-top: 50rpx;
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 14rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.dot-nt { background: #9b6bff; }
.dot-nf { background: #5fd9a8; }
.dot-sj { background: #5fa8ff; }
.dot-sp { background: #ff9b5f; }

