<!--pages/mbti/index.wxml-->
<view class="page cyber-bg {{themeClass}}">
  <view class="header">
    <view class="cyber-title">MBTI</view>
    <view class="cyber-subtitle">{{mode === 'select' ? '选择你最接近的人格类型' : '你的人格类型'}}</view>
  </view>

  <!-- 选择方式 -->
  <view wx:if="{{mode === 'choose'}}" class="entry">
    <view class="entry-card card" bindtap="goSelect">
      <text class="entry-emoji">🧭</text>
      <view class="entry-main">
        <view class="entry-title">我知道我的 MBTI</view>
        <view class="entry-sub">直接选，3 秒搞定</view>
      </view>
      <text class="entry-arrow">▸</text>
    </view>

    <view class="entry-card card" bindtap="goQuiz">
      <text class="entry-emoji">📝</text>
      <view class="entry-main">
        <view class="entry-title">帮我测一下</view>
        <view class="entry-sub">16 道题，自动算出你的类型</view>
      </view>
      <text class="entry-arrow">▸</text>
    </view>
  </view>

  <!-- 直接选 16 型 -->
  <block wx:else>
    <view class="grid">
      <view
        class="type-card card group-{{item.group}} {{item.selected ? 'selected' : ''}}"
        wx:for="{{list}}"
        wx:key="code"
        data-code="{{item.code}}"
        bindtap="onPick"
        style="animation-delay: {{index * 30}}ms"
      >
        <view class="type-code">{{item.code}}</view>
        <view class="type-label">{{item.label}}</view>
        <view class="type-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="legend">
      <view class="legend-item"><view class="dot dot-nt"></view><text>分析师 NT</text></view>
      <view class="legend-item"><view class="dot dot-nf"></view><text>外交官 NF</text></view>
      <view class="legend-item"><view class="dot dot-sj"></view><text>守护者 SJ</text></view>
      <view class="legend-item"><view class="dot dot-sp"></view><text>探险家 SP</text></view>
    </view>

    <view class="back-choose" bindtap="backToChoose">← 换成做题</view>
  </block>
</view>
