/* pages/mbtiQuiz/index.wxss */
.page {
  min-height: 100vh;
  padding: 30rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部进度 */
.top {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-top: 10rpx;
}
.progress-track {
  flex: 1;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--theme);
  box-shadow: 0 0 8rpx rgba(var(--theme-rgb), 0.6);
  transition: width 0.3s ease;
}
.counter {
  font-family: "JetBrains Mono", "Menlo", monospace;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
}

/* 题目 */
.q-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx 0 60rpx;
}
.q-tag {
  font-size: 22rpx;
  color: var(--theme);
  letter-spacing: 2rpx;
  opacity: 0.8;
  margin-bottom: 28rpx;
  text-align: center;
}
.answer-echo {
  align-self: center;
  max-width: 100%;
  margin-bottom: 28rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.72);
  background: rgba(var(--theme-rgb), 0.1);
  border: 1rpx solid rgba(var(--theme-rgb), 0.28);
  text-align: center;
}
.q-text {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #ffffff;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 圆点量表 */
.scale {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 10rpx 0 40rpx;
}
.scale-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 0;
}
.dots {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.dot-wrap {
  width: 112rpx;
  min-height: 122rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
}
.dot-wrap:active {
  transform: translateY(2rpx) scale(0.96);
}
.dot-wrap-sel {
  background: rgba(var(--theme-rgb), 0.14);
  border-color: rgba(var(--theme-rgb), 0.5);
  box-shadow: 0 0 18rpx rgba(var(--theme-rgb), 0.2);
}
.dot {
  border-radius: 50%;
  border: 2rpx solid rgba(var(--theme-rgb), 0.55);
  background: rgba(var(--theme-rgb), 0.06);
  transition: all 0.15s ease;
}
/* 两端大、中间小的经典造型 */
.dot-0, .dot-4 { width: 72rpx; height: 72rpx; }
.dot-1, .dot-3 { width: 58rpx; height: 58rpx; }
.dot-2 { width: 46rpx; height: 46rpx; border-color: rgba(255, 255, 255, 0.3); }

.dot-wrap-sel .dot {
  background: var(--theme);
  border-color: var(--theme);
  box-shadow: 0 0 20rpx rgba(var(--theme-rgb), 0.55);
}
.dot-text {
  padding-bottom: 12rpx;
  font-size: 20rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.42);
  letter-spacing: 0;
}
.dot-wrap-sel .dot-text {
  color: #ffffff;
}

.back-link {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 2rpx;
  padding: 10rpx;
}
