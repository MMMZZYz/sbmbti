/* pages/dimResult/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 30rpx 80rpx;
}

/* 维度标签行 */
.dim-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(var(--theme-rgb), 0.12);
  border: 1rpx solid rgba(var(--theme-rgb), 0.32);
}

.dim-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.dim-name {
  font-size: 22rpx;
  color: var(--theme);
  letter-spacing: 3rpx;
}

/* 结果主体 */
.result-hero {
  margin-top: 52rpx;
  text-align: center;
}

.result-type {
  font-family: "JetBrains Mono", "Menlo", monospace;
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 0 24rpx rgba(var(--theme-rgb), 0.65);
  line-height: 1.1;
}

.result-nick {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 3rpx;
}

.result-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
  line-height: 1.7;
  padding: 0 20rpx;
}

.status-badge {
  display: inline-block;
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  background: var(--theme);
  color: #071018;
  font-weight: 600;
}

.status-quick {
  background: rgba(var(--theme-rgb), 0.14);
  color: var(--theme);
  border: 1rpx solid rgba(var(--theme-rgb), 0.5);
}

/* 详情卡片 */
.detail-card {
  margin-top: 44rpx;
}

.detail-section-title {
  font-size: 18rpx;
  color: var(--theme);
  letter-spacing: 6rpx;
  opacity: 0.7;
  margin-bottom: 18rpx;
  text-align: center;
}

.detail-text {
  font-size: 27rpx;
  line-height: 1.95;
  color: #e0e0f0;
  letter-spacing: 0.5rpx;
}

/* 操作区 */
.actions {
  margin-top: 44rpx;
  display: flex;
  justify-content: center;
}

.retake-btn {
  padding: 22rpx 60rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.disclaimer {
  margin: 34rpx auto 0;
  max-width: 620rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.28);
  letter-spacing: 0;
}
