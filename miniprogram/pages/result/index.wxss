/* pages/result/index.wxss — 一屏化结果页 */
.page { padding: 40rpx 30rpx 60rpx; }

/* —— 折叠态主屏 —— */
.screen {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.header {
  text-align: center;
  padding: 20rpx 0 10rpx;
}

.archive-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.55);
}

/* —— 角色头像 —— */
.avatar-wrap {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 10rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-ring-outer {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--theme-rgb), 0.25) 0%, rgba(var(--theme-rgb), 0) 70%);
  filter: blur(8rpx);
}
.avatar-ring-mid {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(var(--theme-rgb), 0.6);
  box-shadow: 0 0 30rpx rgba(var(--theme-rgb), 0.5),
              inset 0 0 30rpx rgba(var(--theme-rgb), 0.18);
}
.avatar-emoji {
  font-size: 140rpx;
  line-height: 1;
  z-index: 1;
  text-shadow: 0 0 24rpx rgba(var(--theme-rgb), 0.7);
}

/* code card */
.code-card {
  text-align: center;
  padding: 36rpx 24rpx;
}
.code-label {
  font-size: 20rpx;
  color: var(--theme);
  letter-spacing: 6rpx;
  opacity: 0.7;
}
.code-main {
  font-family: "JetBrains Mono", "Menlo", monospace;
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 14rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 0 16rpx rgba(var(--theme-rgb), 0.55);
}
.code-nick {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

/* mini grid 2行4列 */
.mini-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.mini-cell {
  padding: 18rpx 6rpx;
  text-align: center;
  border-radius: 14rpx;
}
.mini-cell-missing {
  opacity: 0.58;
  border-style: dashed;
}
.mini-emoji {
  font-size: 36rpx;
  line-height: 1;
}
.mini-name {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
}
.mini-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* short summary */
.short-summary {
  padding: 24rpx 28rpx;
}
.short-summary-title {
  font-size: 18rpx;
  color: var(--theme);
  letter-spacing: 6rpx;
  opacity: 0.7;
  text-align: center;
}
.short-summary-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.85;
  color: #e6e6f5;
  letter-spacing: 0.5rpx;
  white-space: pre-line;
}

/* actions */
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}
.actions .cyber-btn {
  flex: 1;
  padding: 22rpx 0;
}

.link-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 20rpx 0;
}
.link {
  font-size: 24rpx;
  color: var(--theme);
  letter-spacing: 2rpx;
}
.link-secondary {
  color: rgba(255, 255, 255, 0.35);
}

/* —— 展开详情 —— */
.detail {
  margin-top: 60rpx;
  padding-top: 40rpx;
  border-top: 1rpx dashed rgba(var(--theme-rgb), 0.3);
}
.detail-title {
  text-align: center;
  font-size: 22rpx;
  color: var(--theme);
  letter-spacing: 6rpx;
  margin-bottom: 30rpx;
  opacity: 0.7;
}

.long-summary {
  padding: 28rpx;
}
.long-summary-text {
  font-size: 26rpx;
  line-height: 1.85;
  color: #e6e6f5;
  white-space: pre-line;
  display: block;
}

.full-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}
.full-cell {
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.full-cell-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.full-cell-emoji { font-size: 28rpx; }
.full-cell-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
}
.full-cell-label {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
  margin-top: 4rpx;
}
.full-cell-status {
  align-self: flex-start;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #071018;
  background: var(--theme);
}
.full-cell-status-quick {
  color: var(--theme);
  background: rgba(var(--theme-rgb), 0.14);
  border: 1rpx solid rgba(var(--theme-rgb), 0.5);
}
.full-cell-desc {
  font-size: 22rpx;
  color: #b0b0c8;
  line-height: 1.5;
}

/* bars */
.bars {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.bar-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 18rpx;
}
.bar-name {
  width: 80rpx;
  color: rgba(255, 255, 255, 0.5);
}
.bar-name.win { color: var(--theme); font-weight: 600; }
.bar-track {
  flex: 1;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3rpx;
  overflow: hidden;
}
.bar-val {
  height: 100%;
  background: rgba(var(--theme-rgb), 0.5);
}
.bar-val.win { background: var(--theme); }
.bar-pct {
  width: 60rpx;
  text-align: right;
  color: rgba(255, 255, 255, 0.5);
}
.bar-pct.win { color: var(--theme); font-weight: 600; }

/* off canvas */
.off-canvas {
  position: fixed;
  right: 0;
  bottom: 0;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}
