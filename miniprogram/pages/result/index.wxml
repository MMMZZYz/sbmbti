<!--pages/result/index.wxml — 一屏化折叠式 -->
<view class="page cyber-bg {{themeClass}}">

  <!-- 折叠态主屏 -->
  <view class="screen">
    <view class="header">
      <view class="cyber-title">CYBER ARCHIVE</view>
      <view class="cyber-subtitle">{{archiveTitle}} · 我的八维人格卡</view>
      <view class="archive-subtitle">{{archiveSubtitle}}</view>
    </view>

    <!-- 角色头像 -->
    <view class="avatar-wrap">
      <view class="avatar-ring-outer"></view>
      <view class="avatar-ring-mid"></view>
      <view class="avatar-emoji">{{avatar}}</view>
    </view>

    <!-- 主代号 -->
    <view class="code-card card card-active">
      <view class="code-label">IDENTITY CODE</view>
      <view class="code-main">{{code}}</view>
      <view class="code-nick">— {{nickname}} —</view>
    </view>

    <!-- 八个 mini cell -->
    <view class="mini-grid">
      <view class="mini-cell card {{item.done ? '' : 'mini-cell-missing'}}" wx:for="{{miniCells}}" wx:key="key">
        <view class="mini-emoji">{{item.emoji}}</view>
        <view class="mini-name">{{item.name}}</view>
        <view class="mini-label">{{item.label}}</view>
      </view>
    </view>

    <!-- 短总结 -->
    <view class="short-summary card">
      <view class="short-summary-title">— PROFILE SUMMARY —</view>
      <view class="short-summary-text">{{shortSummary}}</view>
    </view>

    <!-- 按钮区 -->
    <view class="actions">
      <view class="cyber-btn cyber-btn-purple" bindtap="onSaveImage">{{saving ? '生成中...' : '保存为图片'}}</view>
      <button class="cyber-btn" open-type="share">分享给朋友</button>
    </view>

    <view class="link-row">
      <text class="link" bindtap="toggleDetail">{{showDetail ? '收起详情 ▴' : '查看完整解读 ▾'}}</text>
      <text class="link link-secondary" bindtap="onRetake">重新测试</text>
    </view>
  </view>

  <!-- 展开详情 -->
  <view class="detail" wx:if="{{showDetail}}">
    <view class="detail-title">— 完整档案 —</view>

    <!-- 长总结 -->
    <view class="long-summary card">
      <text class="long-summary-text">{{longSummary}}</text>
    </view>

    <!-- 完整八格 -->
    <view class="full-grid">
      <view class="full-cell card" wx:for="{{cells}}" wx:key="key">
        <view class="full-cell-top">
          <text class="full-cell-emoji">{{item.emoji}}</text>
          <text class="full-cell-name">{{item.name}}</text>
        </view>
        <view class="full-cell-label">{{item.label}}</view>
        <view class="full-cell-status {{item.isQuick ? 'full-cell-status-quick' : ''}}">{{item.statusText}}</view>
        <view class="full-cell-desc">{{item.desc}}</view>

        <view wx:if="{{item.bars.length > 0}}" class="bars">
          <view class="bar-row" wx:for="{{item.bars}}" wx:for-item="b" wx:key="type">
            <view class="bar-name {{b.isWinner ? 'win' : ''}}">{{b.name}}</view>
            <view class="bar-track">
              <view class="bar-val {{b.isWinner ? 'win' : ''}}" style="width: {{b.pct}}%"></view>
            </view>
            <view class="bar-pct {{b.isWinner ? 'win' : ''}}">{{b.pct}}%</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 离屏 canvas -->
  <canvas type="2d" id="share-canvas" class="off-canvas"></canvas>
</view>
